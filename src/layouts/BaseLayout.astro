---
import siteData from '../data/siteData.json';
import {
  buildJsonLdGraph,
  normalizeAstroHref,
  optimizeImageUrlToWebp
} from '../utils/seoAndContent.js';

interface Props {
  entity: any;
  routeContext: { type: 'page' | 'service' | 'post'; id: string };
  preloadImage?: string;
}

const { entity, routeContext, preloadImage } = Astro.props;
const g = siteData.global;
const seo = entity?.seo || {};
const domain = (g.domain || 'https://idraulico-a-reggio-emilia.it').replace(/\/+$/, '');

const title = seo.title || entity?.h1 || entity?.title || g.businessName;
const description = seo.description || '';
const keywords = seo.keywords || '';
const robots = seo.robots || 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';
const canonical = seo.canonical || `${domain}/`;
const ogType = seo.ogType || 'website';
const ogTitle = seo.ogTitle || title;
const ogDescription = seo.ogDescription || description;
const ogImage = optimizeImageUrlToWebp(seo.ogImage || siteData.pages.home.heroImage);
const geoRegion = seo.geoRegion || g.defaultGeoRegion || 'IT-RE';
const geoPlacename = seo.geoPlacename || g.defaultGeoPlacename || 'Reggio Emilia';
const geoPosition = seo.geoPosition || `${g.defaultLatitude};${g.defaultLongitude}`;

const jsonLdData = buildJsonLdGraph(siteData, routeContext, entity);
const lcpImageHref = preloadImage ? optimizeImageUrlToWebp(preloadImage) : null;

const logoMode = g.logoMode || 'iconAndText';
const hasCustomLogo = Boolean(String(g.logoImageUrl || '').trim());
const logoSrc = optimizeImageUrlToWebp(g.logoImageUrl);
const logoAlt = g.logoImageAlt || `${g.brandPrefix} ${g.brandSuffix}`;
const logoHeightPx = Math.min(80, Math.max(24, Number(g.logoHeightPx) || 40));
const showLogoInFooter = g.showLogoInFooter !== false && hasCustomLogo && (logoMode === 'imageOnly' || logoMode === 'imageAndText');

const ctaHref = normalizeAstroHref(g.ctaHref || g.phoneHref);
const fCtaLabel = g.footerCtaLabel || g.ctaLabel;
const fCtaHref = normalizeAstroHref(g.footerCtaHref || g.ctaHref || g.phoneHref);
const logoHref = normalizeAstroHref(g.headerLogoHref || '/');

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
function isLinkActive(rawHref: string) {
  const clean = normalizeAstroHref(rawHref).replace(/\/+$/, '') || '/';
  if (clean === '/') return currentPath === '/';
  if (clean === '/servizi') return currentPath === '/servizi' || currentPath.startsWith('/servizi/');
  if (clean === '/blog') return currentPath === '/blog' || currentPath.startsWith('/blog/');
  return currentPath === clean;
}
---
<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph / Social & AI Preview Meta -->
  <meta property="og:locale" content="it_IT" />
  <meta property="og:site_name" content={g.businessName} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />

  <!-- Twitter Card Meta -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={ogDescription} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Local GEO Meta Tags -->
  <meta name="geo.region" content={geoRegion} />
  <meta name="geo.placename" content={geoPlacename} />
  <meta name="geo.position" content={geoPosition} />
  <meta name="ICBM" content={geoPosition.replace(';', ', ')} />

  <!-- Schema.org JSON-LD Pre-Renderizzato -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdData)} />

  <!-- Preconnect & Preload LCP WebP -->
  <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
  <link rel="dns-prefetch" href="https://images.unsplash.com" />
  {lcpImageHref && <link rel="preload" as="image" href={lcpImageHref} fetchpriority="high" />}

  <!-- Google Fonts Inter Asincrono (Zero Render-Blocking) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </noscript>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased flex flex-col min-h-screen">
  <!-- HEADER PRINCIPALE -->
  <header class="sticky top-0 z-40 bg-white shadow-sm border-b border-slate-100">
    <div class="container mx-auto px-4 lg:px-8 py-4 flex justify-between items-center gap-4">
      <a href={logoHref} class="flex items-center gap-2.5 text-2xl font-extrabold tracking-tight text-brand-blue">
        {logoMode === 'imageOnly' && hasCustomLogo ? (
          <img src={logoSrc} alt={logoAlt} style={`height: ${logoHeightPx}px; width: auto;`} class="object-contain max-w-[220px]" />
        ) : logoMode === 'imageAndText' && hasCustomLogo ? (
          <>
            <img src={logoSrc} alt={logoAlt} style={`height: ${logoHeightPx}px; width: auto;`} class="object-contain max-w-[160px]" />
            <span>{g.brandPrefix} <span class="text-brand-light">{g.brandSuffix}</span></span>
          </>
        ) : (
          <>
            <span class="w-9 h-9 rounded-xl bg-brand-blue text-white flex items-center justify-center shadow-sm shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </span>
            <span>{g.brandPrefix} <span class="text-brand-light">{g.brandSuffix}</span></span>
          </>
        )}
      </a>

      <nav aria-label="Navigazione principale" class="hidden lg:flex items-center gap-7 text-sm">
        {(g.headerNav || []).map((item: any) => {
          const href = normalizeAstroHref(item.href);
          const active = isLinkActive(href);
          const linkClass = active
            ? 'text-brand-blue font-bold border-b-2 border-brand-light pb-1'
            : 'text-slate-700 hover:text-brand-light font-medium transition-colors';

          if (item.showServicesDropdown) {
            return (
              <div class="relative group py-2">
                <a href={href} class={`${linkClass} inline-flex items-center gap-1`}>
                  <span>{item.label}</span>
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>
                <div class="hidden group-hover:block absolute left-0 top-full w-64 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50">
                  <a href="/servizi" class="block px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-brand-blue hover:bg-slate-50 border-b border-slate-100">
                    {g.headerDropdownAllLabel || 'Tutti i Servizi (Hub)'}
                  </a>
                  {(siteData.services || []).map((srv: any) => (
                    <a href={`/servizi/${srv.slug}`} class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-sky-50 hover:text-brand-blue font-medium">
                      {srv.shortTitle}
                    </a>
                  ))}
                </div>
              </div>
            );
          }

          return <a href={href} class={linkClass}>{item.label}</a>;
        })}
      </nav>

      <div class="flex items-center gap-2.5">
        <a
          href={ctaHref}
          class="inline-flex items-center gap-2 bg-brand-green hover:bg-brand-greenHover text-white font-bold px-4 sm:px-5 py-2.5 rounded-xl shadow-sm transition-colors text-xs sm:text-sm"
        >
          {ctaHref.startsWith('tel:') && (
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          )}
          <span>{g.ctaLabel}</span>
        </a>

        <button
          id="mobile-menu-toggle"
          type="button"
          class="lg:hidden p-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700"
          aria-label="Apri menu di navigazione"
          aria-expanded="false"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <nav id="mobile-nav-drawer" aria-label="Navigazione mobile" class="hidden lg:hidden bg-white border-t border-slate-100 px-4 py-4 space-y-2">
      {(g.headerNav || []).map((item: any) => {
        const href = normalizeAstroHref(item.href);
        if (item.showServicesDropdown) {
          return (
            <>
              <a href={href} class="block px-3 py-2.5 rounded-xl font-semibold text-brand-blue bg-sky-50/60">
                {item.label}
              </a>
              <div class="pl-4 space-y-1 border-l-2 border-sky-200 ml-3">
                {(siteData.services || []).map((srv: any) => (
                  <a href={`/servizi/${srv.slug}`} class="block px-3 py-2 rounded-lg text-sm text-slate-600 hover:text-brand-blue">
                    {srv.shortTitle}
                  </a>
                ))}
              </div>
            </>
          );
        }
        return (
          <a href={href} class="block px-3 py-2.5 rounded-xl font-semibold text-slate-800 hover:bg-slate-50">
            {item.label}
          </a>
        );
      })}
    </nav>
  </header>

  <!-- CONTENUTO PRINCIPALE -->
  <main id="contenuto-principale" class="flex-grow">
    <slot />
  </main>

  <!-- FOOTER PRINCIPALE -->
  <footer class="bg-slate-900 text-slate-300 py-12 mt-auto">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-10 border-b border-slate-800">
        <div class="space-y-4">
          <div class="text-xl font-extrabold text-white">
            {showLogoInFooter && logoMode === 'imageOnly' ? (
              <img src={logoSrc} alt={logoAlt} style={`height: ${logoHeightPx}px; width: auto;`} class="object-contain max-w-[200px] bg-white/95 px-2.5 py-1 rounded-xl" />
            ) : showLogoInFooter && logoMode === 'imageAndText' ? (
              <div class="inline-flex items-center gap-3">
                <img src={logoSrc} alt={logoAlt} style={`height: ${logoHeightPx}px; width: auto;`} class="object-contain max-w-[160px] bg-white/95 px-2 py-1 rounded-xl" />
                <span>{g.brandPrefix} <span class="text-brand-accent">{g.brandSuffix}</span></span>
              </div>
            ) : (
              <span>{g.brandPrefix} <span class="text-brand-accent">{g.brandSuffix}</span></span>
            )}
          </div>
          <p class="text-sm text-slate-300 leading-relaxed">{g.footerTagline}</p>
          {g.piva && <p class="text-xs text-slate-300">P.IVA {g.piva}</p>}
        </div>

        <div>
          <div class="text-white font-bold text-sm uppercase tracking-wider mb-4">{g.footerCol2Title || 'Navigazione'}</div>
          <ul class="space-y-2.5 text-sm">
            {(g.footerNavLinks || []).map((lk: any) => (
              <li>
                <a href={normalizeAstroHref(lk.href)} class="hover:text-white transition-colors">{lk.label}</a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <div class="text-white font-bold text-sm uppercase tracking-wider mb-4">{g.footerCol3Title || 'Servizi a Reggio Emilia'}</div>
          <ul class="space-y-2.5 text-sm">
            {(siteData.services || []).map((srv: any) => (
              <li>
                <a href={`/servizi/${srv.slug}`} class="hover:text-white transition-colors">{srv.shortTitle}</a>
              </li>
            ))}
          </ul>
        </div>

        <address class="not-italic space-y-3 text-sm">
          <div class="text-white font-bold text-sm uppercase tracking-wider mb-4">{g.footerCol4Title || 'Sede e Contatti'}</div>
          <p>{g.address}</p>
          <p>{g.hours}</p>
          <p><a href={`mailto:${g.email}`} class="hover:text-white transition-colors">{g.email}</a></p>
          <div class="pt-2">
            <a
              href={fCtaHref}
              class="inline-flex items-center gap-2 bg-brand-green hover:bg-brand-greenHover text-white font-bold px-4 py-2.5 rounded-xl text-xs transition-colors"
            >
              {fCtaHref.startsWith('tel:') && (
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              )}
              <span>{fCtaLabel}</span>
            </a>
          </div>
        </address>
      </div>

      <div class="pt-6 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-300 gap-3">
        <p>{g.footerCopyright}</p>
        <div class="flex flex-wrap items-center justify-center sm:justify-end gap-4">
          <p>{g.footerBottomNote}</p>
          <a href="/admin" class="text-slate-400 hover:text-white underline-offset-2 hover:underline transition-colors">
            Area Riservata
          </a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    const btn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    if (btn && drawer) {
      btn.addEventListener('click', () => {
        const isHidden = drawer.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', String(!isHidden));
      });
    }
  </script>
</body>
</html>
