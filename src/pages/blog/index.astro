---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteData from '../../data/siteData.json';
import {
  buildResponsiveSrcset,
  normalizeAstroHref,
  optimizeImageUrlToWebp
} from '../../utils/seoAndContent.js';

const p = siteData.pages.blog;
const g = siteData.global;
const ctaHref = normalizeAstroHref(p.ctaHref || g.phoneHref);
const ctaLabel = p.ctaLabel || g.ctaLabel;
const firstPostImage = siteData.posts[0]?.coverImage;
---

<BaseLayout entity={p} routeContext={{ type: 'page', id: 'blog' }} preloadImage={firstPostImage}>
  <article>
    <section class="bg-brand-blue text-white py-14 lg:py-20">
      <div class="container mx-auto px-4 lg:px-8 max-w-4xl text-center space-y-4">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold">{p.h1}</h1>
        <p class="text-blue-100 text-base sm:text-lg leading-relaxed">{p.heroSubtitle}</p>
      </div>
    </section>

    <section class="py-14 lg:py-20 container mx-auto px-4 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {(siteData.posts || []).map((post, idx) => (
          <div class="bg-white rounded-3xl border border-slate-200/90 shadow-xs hover:shadow-md transition-shadow overflow-hidden flex flex-col">
            <img
              src={optimizeImageUrlToWebp(post.coverImage)}
              srcset={buildResponsiveSrcset(post.coverImage)}
              sizes="(max-width: 768px) 100vw, 33vw"
              alt={post.coverImageAlt}
              width="800"
              height="500"
              loading={idx === 0 ? 'eager' : 'lazy'}
              fetchpriority={idx === 0 ? 'high' : undefined}
              decoding="async"
              class="w-full h-52 object-cover"
            />
            <div class="p-6 sm:p-7 flex flex-col flex-grow">
              <div class="flex items-center justify-between text-xs text-slate-500 mb-3">
                <span class="bg-sky-50 text-brand-light font-bold px-3 py-1 rounded-full">{post.category}</span>
                <span>{post.readingTime}</span>
              </div>
              <h2 class="text-xl font-extrabold text-slate-900 mb-3 leading-snug">{post.title}</h2>
              <p class="text-sm text-slate-600 leading-relaxed mb-5 flex-grow">{post.excerpt}</p>
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs text-slate-400">{post.date}</span>
                <a href={`/blog/${post.slug}`} class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-blue hover:text-brand-light">
                  <span>Leggi articolo</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- CTA BLOG HUB -->
      <div class="mt-16 bg-brand-blue text-white rounded-3xl p-8 sm:p-12 shadow-xl flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <h2 class="text-2xl sm:text-3xl font-extrabold">{p.ctaTitle}</h2>
          <p class="text-blue-100 text-base">{p.ctaText}</p>
        </div>
        <div class="shrink-0">
          <a
            href={ctaHref}
            class="inline-flex items-center justify-center gap-2 bg-brand-green hover:bg-brand-greenHover text-white font-bold px-8 py-4 rounded-xl shadow-lg transition-colors text-base"
          >
            <span>{ctaLabel}</span>
          </a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
