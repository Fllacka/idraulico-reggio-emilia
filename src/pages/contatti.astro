---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../data/siteData.json';
import { normalizeAstroHref } from '../utils/seoAndContent.js';

const p = siteData.pages.contatti;
const g = siteData.global;
const ctaHref = normalizeAstroHref(p.ctaHref || g.phoneHref);
const ctaLabel = p.ctaLabel || g.ctaLabel;
const recipientEmail = g.contactRecipientEmail || 'idraulico.re@gmail.com';
---

<BaseLayout entity={p} routeContext={{ type: 'page', id: 'contatti' }}>
  <article>
    <section class="bg-brand-blue text-white py-14 lg:py-20">
      <div class="container mx-auto px-4 lg:px-8 max-w-4xl text-center space-y-4">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold">{p.h1}</h1>
        <p class="text-blue-100 text-base sm:text-lg leading-relaxed">{p.heroSubtitle}</p>
      </div>
    </section>

    <section class="py-14 lg:py-20 container mx-auto px-4 lg:px-8 max-w-6xl grid lg:grid-cols-12 gap-10">
      <!-- COLONNA RECAPITI -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-sky-50 border border-sky-200 rounded-3xl p-6 sm:p-7 space-y-3">
          <div class="text-lg font-extrabold text-brand-blue">{p.infoBoxTitle}</div>
          <p class="text-sm text-slate-700 leading-relaxed">{p.infoBoxText}</p>
          <div class="pt-2">
            <a
              href={ctaHref}
              class="w-full inline-flex items-center justify-center gap-2 bg-brand-green hover:bg-brand-greenHover text-white font-bold px-6 py-4 rounded-xl shadow-md transition-colors text-base"
            >
              <span>{ctaLabel}</span>
            </a>
          </div>
        </div>

        <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-7 space-y-4 text-sm">
          <div>
            <div class="text-xs font-extrabold uppercase tracking-wider text-slate-400">Sede Operativa</div>
            <div class="font-bold text-slate-900 mt-1">{g.address}</div>
          </div>
          <div>
            <div class="text-xs font-extrabold uppercase tracking-wider text-slate-400">Orari</div>
            <div class="font-semibold text-slate-700 mt-1">{g.hours}</div>
          </div>
          <div>
            <div class="text-xs font-extrabold uppercase tracking-wider text-slate-400">Email</div>
            <div class="mt-1"><a href={`mailto:${g.email}`} class="text-brand-light font-semibold hover:underline">{g.email}</a></div>
          </div>
          <div>
            <div class="text-xs font-extrabold uppercase tracking-wider text-slate-400">Comuni Serviti</div>
            <div class="flex flex-wrap gap-1.5 mt-2">
              {(g.areaServed || []).map((city) => (
                <span class="bg-slate-100 text-slate-700 text-xs font-medium px-2.5 py-1 rounded-lg">{city}</span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- COLONNA MODULO PREVENTIVO -->
      <div class="lg:col-span-7 bg-white rounded-3xl border border-slate-200 p-7 sm:p-10 shadow-xs">
        <h2 class="text-2xl font-extrabold text-brand-blue mb-2">Richiedi un Preventivo o Sopralluogo</h2>
        <p class="text-sm text-slate-600 mb-6">Compila i campi qui sotto: ti risponderemo entro 24 ore lavorative.</p>

        <form id="contact-form" data-recipient={recipientEmail} class="space-y-4">
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-nome" class="block text-xs font-bold text-slate-700 mb-1.5">Nome e Cognome *</label>
              <input id="contact-nome" type="text" name="nome" required placeholder="Es. Marco Rossi" class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:outline-none focus:border-brand-light" />
            </div>
            <div>
              <label for="contact-telefono" class="block text-xs font-bold text-slate-700 mb-1.5">Telefono *</label>
              <input id="contact-telefono" type="tel" name="telefono" required placeholder="Es. 333 1234567" class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:outline-none focus:border-brand-light" />
            </div>
          </div>

          <div>
            <label for="contact-comune" class="block text-xs font-bold text-slate-700 mb-1.5">Comune (Provincia RE)</label>
            <input id="contact-comune" type="text" name="comune" placeholder="Es. Reggio Emilia, Scandiano..." class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:outline-none focus:border-brand-light" />
          </div>

          <div>
            <label for="contact-messaggio" class="block text-xs font-bold text-slate-700 mb-1.5">Descrizione del lavoro richiesto *</label>
            <textarea id="contact-messaggio" name="messaggio" rows="4" required placeholder="Descrivi brevemente il lavoro che desideri realizzare..." class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm focus:outline-none focus:border-brand-light"></textarea>
          </div>

          <button id="contact-submit-btn" type="submit" class="w-full bg-brand-blue hover:bg-blue-800 text-white font-bold py-4 rounded-xl shadow-md transition-colors text-base">
            Invia Richiesta di Preventivo
          </button>

          <div id="contact-form-feedback" class="pt-2"></div>
        </form>
      </div>
    </section>
  </article>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const feedback = document.getElementById('contact-form-feedback');
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;

    if (form) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const formData = new FormData(form);
        const name = String(formData.get('nome') || '').trim();
        const phone = String(formData.get('telefono') || '').trim();
        const city = String(formData.get('comune') || '').trim();
        const message = String(formData.get('messaggio') || '').trim();
        const recipientEmail = form.dataset.recipient || 'idraulico.re@gmail.com';

        const mailSubject = `Richiesta Preventivo Sito Web - ${name || 'Cliente'}`;
        const mailBody = [
          'Nuova richiesta dal modulo contatti del sito:',
          '',
          `Nome e Cognome: ${name}`,
          `Telefono: ${phone}`,
          `Comune: ${city || 'Non specificato'}`,
          '',
          'Descrizione del lavoro richiesto:',
          message
        ].join('\n');
        const mailtoHref = `mailto:${encodeURIComponent(recipientEmail)}?subject=${encodeURIComponent(mailSubject)}&body=${encodeURIComponent(mailBody)}`;

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Invio richiesta in corso...';
        }

        try {
          const response = await fetch(`https://formsubmit.co/ajax/${encodeURIComponent(recipientEmail)}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json'
            },
            body: JSON.stringify({
              name,
              Telefono: phone,
              Comune: city || 'Non specificato',
              Messaggio: message,
              _subject: mailSubject,
              _template: 'table',
              _captcha: 'false'
            })
          });

          if (!response.ok) throw new Error('Errore server');

          if (feedback) {
            feedback.innerHTML = `
              <div class="p-4 rounded-2xl bg-green-50 border border-green-200 text-green-900 text-sm font-medium space-y-1.5">
                <p>Grazie! La tua richiesta è stata inviata a <strong>${recipientEmail}</strong>. Un nostro tecnico di Reggio Emilia ti ricontatterà a breve.</p>
                <p class="text-xs text-green-800">Vuoi inviare anche una copia dal tuo programma di posta? <a href="${mailtoHref}" class="underline font-bold">Apri client email</a>.</p>
              </div>
            `;
          }
          form.reset();
        } catch {
          if (feedback) {
            feedback.innerHTML = `
              <div class="p-4 rounded-2xl bg-sky-50 border border-sky-200 text-slate-800 text-sm font-medium space-y-2.5">
                <p>Abbiamo preparato la tua richiesta per <strong>${recipientEmail}</strong>.</p>
                <a href="${mailtoHref}" class="inline-flex items-center gap-2 bg-brand-green hover:bg-brand-greenHover text-white font-bold px-4 py-2.5 rounded-xl text-xs transition-colors">
                  Completa l'invio via Email (${recipientEmail}) &rarr;
                </a>
              </div>
            `;
          }
          window.location.href = mailtoHref;
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Invia Richiesta di Preventivo';
          }
        }
      });
    }
  </script>
</BaseLayout>
